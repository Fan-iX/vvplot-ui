{
  "name": "vvplot-ui",
  "version": "0.0.1",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite dev playground"
  },
  "type": "module",
  "module": "./dist/vvplot-ui.esm.js",
  "types": "./dist/vvplot-ui.d.ts",
  "imports": {
    "#base/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/vvplot-ui.d.ts",
      "import": "./dist/vvplot-ui.esm.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.esm.js"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/directives.esm.js"
    },
    "./style.css": "./dist/style.css"
  },
  "homepage": "https://fan-ix.github.io/vvplot-ui/",
  "repository": "https://github.com/Fan-iX/vvplot-ui/",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^13.7.0"
  },
  "peerDependencies": {
    "@iconify-json/lucide": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
