{
  "name": "@vvplot/ui",
  "version": "0.0.4",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config build/vite.esm.config.js && vite build --config build/vite.iife.config.js",
    "dev": "vite dev playground",
    "prepare": "simple-git-hooks"
  },
  "type": "module",
  "module": "./dist/vvplot-ui.esm.js",
  "types": "./dist/vvplot-ui.d.ts",
  "imports": {
    "#base/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/vvplot-ui.d.ts",
      "import": "./dist/vvplot-ui.esm.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.esm.js"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/directives.esm.js"
    },
    "./style.css": "./dist/vvplot-ui.css"
  },
  "homepage": "https://fan-ix.github.io/vvplot-ui/",
  "repository": "https://github.com/Fan-iX/vvplot-ui/",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vueuse/core": "^13.7.0"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@iconify-json/lucide": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "lint-staged": "^17.0.0",
    "simple-git-hooks": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json}": [
      "eslint --cache --fix"
    ]
  }
}
